{
  "name": "@knet/website",
  "version": "0.0.0",
  "private": true,
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/validate-environment.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prepare:assets && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs && node scripts/check-budgets.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "pretypecheck": "npm run prepare:assets",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:container": "node scripts/verify-container.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
